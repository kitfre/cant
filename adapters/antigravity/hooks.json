{
  "cant-context": {
    "PreToolUse": [
      {
        "matcher": "call_mcp_tool|.*repl.*|.*cant.*jobs.*|read_file|view_file|write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|run_command|grep_search|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "cant hook pre-tool --strict",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "cant hook pre-invocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "cant hook stop",
        "timeout": 5
      }
    ]
  }
}
