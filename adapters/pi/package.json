{
  "name": "cant-pi",
  "version": "0.1.0",
  "description": "Thin Pi harness adapter for the Cant local polyglot REPL & jobs daemon",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "../../skills/steel"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
